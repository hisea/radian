(version 1)
(deny default)
(allow file-read*)
(allow file-test-existence)
(allow process-exec*)
(allow process-fork)
(allow mach-lookup)
(allow sysctl-read)
(allow file-write-data (literal "/dev/null"))
(allow file-write* (subpath "<scratch>/radian-spike-sb-61190-0/wt"))
(deny file-write* (literal "<scratch>/radian-spike-sb-61190-0/wt/.git"))
(deny file-write* (subpath "<scratch>/radian-spike-sb-61190-0/mainrepo/.git"))
