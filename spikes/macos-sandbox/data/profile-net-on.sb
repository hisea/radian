(version 1)
(deny default)
(allow file-read*)
(allow file-test-existence)
(allow process-exec*)
(allow process-fork)
(allow mach-lookup)
(allow sysctl-read)
(allow network*)
(allow file-write-data (literal "/dev/null"))
(allow file-write* (subpath "/private<tmpdir>/radian-spike-sb-61190-0/ws"))
(deny file-write* (subpath "/private<tmpdir>/radian-spike-sb-61190-0/ws/proj/.git"))
